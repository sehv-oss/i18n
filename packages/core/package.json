{
  "name": "@sehv-oss/i18n",
  "version": "1.0.1",
  "description": "Modern i18n library for JavaScript. Web standards based, runs everywhere.",
  "type": "module",
  "scripts": {
    "build": "tsdown"
  },
  "files": [
    "./dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.mjs"
    },
    "./formatters": {
      "types": "./dist/formatters/formatters.d.ts",
      "import": "./dist/formatters/formatters.mjs"
    }
  },
  "keywords": [
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "intl",
    "message format",
    "translation"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/sehv-oss/i18n.git",
    "directory": "packages/core"
  },
  "homepage": "https://sehv-oss.github.io/i18n/",
  "bugs": {
    "url": "https://github.com/sehv-oss/i18n/issues"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
