{
  "name": "@sehv-oss/i18n-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "test:setup": "pnpm dlx playwright install chromium --with-deps",
    "test:coverage": "vitest --coverage",
    "clean": "git clean -fdX",
    "lint": "pnpm lint:cspell && pnpm lint:prettier",
    "lint:cspell": "cspell . --config .cspell.config.js",
    "lint:eslint": "pnpm -r lint:eslint",
    "lint:prettier": "prettier --config .prettier.config.js --check ."
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "@vitejs/plugin-react": "5.1.3",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "cspell": "9.6.2",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "tsdown": "0.20.1",
    "typescript": "5.9.3",
    "vitest-browser-react": "2.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
