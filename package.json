{
  "name": "@sehv-oss/i18n-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "vitest",
    "test:setup": "pnpm exec playwright install chromium --with-deps",
    "test:coverage": "vitest --coverage",
    "clean": "git clean -fdX",
    "lint": "pnpm lint:cspell && pnpm lint:prettier && pnpm lint:eslint",
    "lint:cspell": "cspell . --config .cspell.config.js",
    "lint:eslint": "echo \"pnpm --recursive lint:eslint\"",
    "lint:prettier": "prettier --config .prettier.config.js --check .",
    "site:dev": "pnpm --filter @sehv-oss/i18n-site dev"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest-browser-react": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
