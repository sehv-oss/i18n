{
  "name": "@sehv-oss/i18n-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "vitest",
    "test:setup": "pnpm exec playwright install chromium --with-deps",
    "test:coverage": "vitest --coverage",
    "clean": "git clean -fdX",
    "lint": "pnpm lint:cspell && pnpm lint:prettier && pnpm lint:eslint",
    "lint:cspell": "cspell . --config .cspell.config.js",
    "lint:eslint": "echo \"pnpm -r lint:eslint\"",
    "lint:prettier": "prettier --config .prettier.config.js --check ."
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "25.9.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "cspell": "10.0.1",
    "eslint": "10.4.1",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vitest-browser-react": "2.2.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
