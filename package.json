{
  "name": "@sehv-oss/i18n-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "vitest",
    "test:setup": "pnpm exec playwright install chromium --with-deps",
    "test:coverage": "vitest --coverage",
    "clean": "git clean -fdX",
    "lint": "pnpm lint:cspell && pnpm lint:prettier && pnpm lint:eslint",
    "lint:cspell": "cspell . --config .cspell.config.ts",
    "lint:eslint": "echo \"pnpm --recursive lint:eslint\"",
    "lint:prettier": "prettier --config .prettier.config.ts --check .",
    "site:dev": "pnpm --filter @sehv-oss/i18n-site dev"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest-browser-react": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
